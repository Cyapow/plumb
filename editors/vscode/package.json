{
  "name": "plumb-vscode",
  "displayName": "Open in Plumb",
  "description": "Open the current workspace in the Plumb Git client.",
  "version": "0.1.0",
  "publisher": "cyapow",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Cyapow/plumb" },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["SCM Providers", "Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "plumb.openPanel", "title": "Open Plumb Panel", "category": "Plumb" },
      { "command": "plumb.openRepo", "title": "Open in Plumb (desktop)", "category": "Plumb" }
    ],
    "menus": {
      "scm/title": [{ "command": "plumb.openPanel", "group": "navigation" }],
      "explorer/context": [{ "command": "plumb.openPanel", "group": "navigation@99" }]
    },
    "configuration": {
      "title": "Plumb",
      "properties": {
        "plumb.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Plumb CLI/app binary. Leave empty to use `plumb` on your PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.75.0",
    "typescript": "^5"
  }
}
